{
  "name": "la-mesa",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first 4-player dominoes, All Fives, Venezuelan truco, caída, parchís, roba la cochina and rummy. No login: share /play/<match id> and play.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:tools": "DEV_TOOLS=1 node --watch server/index.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "sim": "node scripts/sim.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "partyserver": "0.5.10",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
